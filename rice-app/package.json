{
  "name": "rice-app",
  "version": "0.1.0",
  "description": "RICE - Runtime Intelligence & Continuous Evolution",
  "main": "dist-electron/main.js",
  "type": "module",
  "author": "RICE Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:electron": "vite build --config vite.config.ts",
    "build": "node scripts/package-app.mjs",
    "build:react": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "prepare:runtime": "node scripts/build-runtime.mjs",
    "package": "node scripts/package-app.mjs",
    "package:mac": "node scripts/package-app.mjs --mac",
    "package:win": "node scripts/package-app.mjs --win",
    "package:linux": "node scripts/package-app.mjs --linux",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "i18n:extract": "i18next \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "i18next": "^26.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.9",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "i18next-parser": "^9.0.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  }
}
