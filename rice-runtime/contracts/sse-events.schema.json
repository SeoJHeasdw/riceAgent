{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rice.app/contracts/sse-events.schema.json",
  "title": "RICE runtime SSE events",
  "description": "9 stream events + 2 control events streamed over POST /sessions/{id}/messages (RICE_CONTRACTS §1.3). Owned by rice-runtime; rice-app codegens/mirrors it (lib/types.ts). Each frame is `event: <type>\\n data: <json>\\n\\n`; `data` matches the schema selected by `type`.",
  "oneOf": [
    { "$ref": "#/$defs/thinking" },
    { "$ref": "#/$defs/tool_call" },
    { "$ref": "#/$defs/tool_result" },
    { "$ref": "#/$defs/message" },
    { "$ref": "#/$defs/skill_created" },
    { "$ref": "#/$defs/memory_written" },
    { "$ref": "#/$defs/skill_patched" },
    { "$ref": "#/$defs/done" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/tool_approval_required" },
    { "$ref": "#/$defs/skill_patch_proposed" }
  ],
  "$defs": {
    "event": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    "thinking": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "thinking" },
        "data": {
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string" } }
        }
      }
    },
    "tool_call": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "tool_call" },
        "data": {
          "type": "object",
          "required": ["tool_call_id", "tool_name", "arguments"],
          "properties": {
            "tool_call_id": { "type": "string" },
            "tool_name": { "type": "string" },
            "arguments": { "type": "object" }
          }
        }
      }
    },
    "tool_result": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "tool_result" },
        "data": {
          "type": "object",
          "required": ["tool_call_id", "ok"],
          "properties": {
            "tool_call_id": { "type": "string" },
            "ok": { "type": "boolean" },
            "result": {},
            "error": { "type": ["string", "null"] }
          }
        }
      }
    },
    "message": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "description": "Either a streaming `delta` or a final `content`.",
      "properties": {
        "type": { "const": "message" },
        "data": {
          "type": "object",
          "properties": {
            "delta": { "type": "string" },
            "content": { "type": "string" }
          }
        }
      }
    },
    "skill_created": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "skill_created" },
        "data": {
          "type": "object",
          "required": ["skill_id", "title", "version"],
          "properties": {
            "skill_id": { "type": "string" },
            "title": { "type": "string" },
            "version": { "type": "integer" }
          }
        }
      }
    },
    "memory_written": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "memory_written" },
        "data": {
          "type": "object",
          "required": ["memory_type", "content"],
          "properties": {
            "memory_type": { "enum": ["fact", "preference"] },
            "content": { "type": "string" }
          }
        }
      }
    },
    "skill_patched": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "skill_patched" },
        "data": {
          "type": "object",
          "required": ["skill_id", "version"],
          "properties": {
            "skill_id": { "type": "string" },
            "version": { "type": "integer" }
          }
        }
      }
    },
    "done": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "done" },
        "data": { "type": "object", "maxProperties": 0 }
      }
    },
    "error": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "error" },
        "data": {
          "type": "object",
          "required": ["error_code", "message"],
          "properties": {
            "error_code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    },
    "tool_approval_required": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "description": "Control event: park the turn until POST /sessions/{id}/tool-approval (RUNTIME_DESIGN §5.1).",
      "properties": {
        "type": { "const": "tool_approval_required" },
        "data": {
          "type": "object",
          "required": ["approval_id", "tool_name", "arguments"],
          "properties": {
            "approval_id": { "type": "string" },
            "tool_name": { "type": "string" },
            "arguments": { "type": "object" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "skill_patch_proposed": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "description": "Control event: park the turn until POST /skills/{id}/patch (LEARNING_LOOP §5.2.3).",
      "properties": {
        "type": { "const": "skill_patch_proposed" },
        "data": {
          "type": "object",
          "required": ["approval_id", "skill_id", "changelog", "diff", "trigger"],
          "properties": {
            "approval_id": { "type": "string" },
            "skill_id": { "type": "string" },
            "changelog": { "type": "string" },
            "trigger": { "enum": ["T1a", "T1b", "T1c", "T3"] },
            "from_version": { "type": "integer" },
            "to_version": { "type": "integer" },
            "diff": {
              "type": "object",
              "required": ["lines"],
              "properties": {
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "text"],
                    "properties": {
                      "type": { "enum": ["add", "remove", "context"] },
                      "text": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
